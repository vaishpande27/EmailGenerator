{
  "name": "Email-Reply Assistant",
  "description": "Base Level Extension",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "*://mail.google.com/*"
  ],
  "content_scripts": [
   {
     "matches": ["*://mail.google.com/*"],
     "css": ["content.css"],
     "js": ["content.js"]
   }
 ],
 "web_accessible_resources": [
    {
      "resources": [ "icons/*" ],
      "matches": [ "*://mail.google.com/*" ]
    }
  ],
  "action": {
    "default_title": "Email Writer Assistant",
    "default_icon": "extensionImg.png"
  }

}